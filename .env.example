# Nonsecret deployment defaults for the Docker Compose (WSL2) deployment.
# Copy to .env and adjust.
#
# LLM connections (URL, model, API key) are configured in the UI
# (Settings → LLM presets), not here.

# Host port the UI is published on (loopback only).
APP_PORT=8080

# Automatic deletion of job data (days).
RETENTION_DAYS=7

# Upload size accepted by the reverse proxy (matches MAX_UPLOAD_MB backend
# default of 2048 MB).
MAX_BODY_SIZE=2g
