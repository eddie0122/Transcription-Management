# Nonsecret deployment defaults for the Docker Compose (WSL2) deployment.
# Copy to .env and adjust. Secrets never go here — see secrets/README.md.

# Host port the UI is published on (loopback only).
APP_PORT=8080

# Automatic deletion of job data (days).
RETENTION_DAYS=7

# Upload size accepted by the reverse proxy (matches MAX_UPLOAD_MB backend
# default of 2048 MB).
MAX_BODY_SIZE=2g

# External LLM (OpenAI-compatible chat completions endpoint).
# TBA is an unconfigured placeholder — translation stays "awaiting
# configuration" and no LLM request is made until real values are supplied.
# If the LLM runs on the Windows host, use a host address reachable from
# Docker Desktop (e.g. http://host.docker.internal:PORT/v1) and make sure the
# host server does not listen on Windows loopback only.
LLM_BASE_URL=TBA
LLM_MODEL=TBA
