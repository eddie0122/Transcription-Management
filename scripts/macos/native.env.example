# Native macOS configuration (no Docker values here).
# Loaded by scripts/macos/start.sh. Values may be overridden in native.env.

# Local listen address/port. Keep the host on loopback.
APP_HOST=127.0.0.1
APP_PORT=8080

# Apple Silicon adapter is the default on this deployment; the UI's hardware
# setting can still choose CPU explicitly.
TRANSCRIPTION_ENGINE=whispercpp
TRANSCRIPTION_DEVICE=auto

# Native data/model paths (defaults shown; DATA_DIR resolves to
# ~/Library/Application Support/AudioTranscription when unset).
#DATA_DIR=
#MODEL_CACHE_DIR=

# Automatic deletion default (days).
RETENTION_DAYS=7

# Explicit whisper-cli path if not on PATH and not built in native/whisper.cpp.
#WHISPER_CPP_BIN=

# LLM connection values are entered in the UI (Settings → LLM presets) and
# stored in the macOS Keychain. They remain TBA until supplied; translation
# shows "awaiting configuration" and transcription works independently.
